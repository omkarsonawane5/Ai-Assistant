# Backend
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://assistant:assistant@localhost:5432/assistant
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
DEV_BOOTSTRAP_USER_EMAIL=local@example.com
DEV_BOOTSTRAP_USER_PASSWORD=local-password

# AI provider. Use fake for local development without external credentials.
AI_PROVIDER=fake
AI_MODEL=fake-local
AI_API_KEY=
ASSISTANT_SYSTEM_PROMPT=You are a helpful, concise AI assistant.
RECENT_MESSAGE_LIMIT=20

# Realtime voice providers are server-side only. Voice reports explicit unavailable errors until adapters are configured.
STT_PROVIDER=unconfigured
STT_MODEL=
STT_API_KEY=
TTS_PROVIDER=unconfigured
TTS_MODEL=
TTS_API_KEY=
REALTIME_SESSION_TTL_SECONDS=90
REALTIME_MAX_AUDIO_CHUNK_BYTES=256000

# Frontend
VITE_API_BASE_URL=http://localhost:8000
